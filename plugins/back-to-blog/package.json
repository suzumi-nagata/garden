{
  "name": "@suzumi-nagata/quartz-back-to-blog",
  "version": "1.0.0",
  "description": "A link back to the main blog, for Suzumi's garden",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./components": {
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"console.log('back-to-blog: dist/ is committed source, nothing to build')\""
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "quartz": {
    "name": "back-to-blog",
    "displayName": "Back to Blog",
    "description": "A link back to the main blog",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {
      "href": "https://suzumi-nagata.github.io",
      "label": "Main Blog"
    },
    "components": {
      "BackToBlog": {
        "name": "BackToBlog",
        "displayName": "Back to Blog",
        "description": "A link back to the main blog",
        "version": "1.0.0",
        "defaultPosition": "left",
        "defaultPriority": 30
      }
    }
  }
}
