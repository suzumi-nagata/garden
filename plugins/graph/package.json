{
  "name": "@suzumi-nagata/quartz-graph",
  "version": "1.0.0",
  "description": "Graph View with folder-index slug and body-scoped theme fixes",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./components": {
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "quartz": {
    "name": "graph",
    "displayName": "Graph",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {
      "localGraph": {
        "drag": true,
        "zoom": true,
        "depth": 1,
        "scale": 1.1,
        "repelForce": 0.5,
        "centerForce": 0.3,
        "linkDistance": 30,
        "fontSize": 0.6,
        "opacityScale": 1,
        "showTags": true,
        "removeTags": [],
        "focusOnHover": false,
        "enableRadial": false
      },
      "globalGraph": {
        "drag": true,
        "zoom": true,
        "depth": -1,
        "scale": 0.9,
        "repelForce": 0.5,
        "centerForce": 0.2,
        "linkDistance": 30,
        "fontSize": 0.6,
        "opacityScale": 1,
        "showTags": true,
        "removeTags": [],
        "focusOnHover": true,
        "enableRadial": true
      }
    },
    "components": {
      "Graph": {
        "displayName": "Graph",
        "defaultPosition": "right",
        "defaultPriority": 10
      }
    },
    "optionSchema": {
      "localGraph": {
        "type": "object"
      },
      "globalGraph": {
        "type": "object"
      }
    }
  }
}
