{
  "name": "@suzumi-nagata/quartz-chapter-nav",
  "version": "1.0.0",
  "description": "Previous/next links between numbered sibling notes",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./components": {
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"console.log('chapter-nav: dist/ is committed source, nothing to build')\""
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "quartz": {
    "name": "chapter-nav",
    "displayName": "Chapter Navigation",
    "description": "Previous/next links between numbered sibling notes",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "defaultOrder": 88,
    "defaultEnabled": true,
    "defaultOptions": {
      "numberPattern": "^\\s*(\\d+)",
      "previousLabel": "Previous chapter",
      "nextLabel": "Next chapter",
      "ariaLabel": "Chapter navigation"
    },
    "components": {
      "ChapterNav": {
        "displayName": "Chapter Navigation",
        "defaultPosition": "afterBody",
        "defaultPriority": 10
      }
    },
    "optionSchema": {
      "numberPattern": {
        "type": "string"
      },
      "previousLabel": {
        "type": "string"
      },
      "nextLabel": {
        "type": "string"
      },
      "ariaLabel": {
        "type": "string"
      }
    }
  }
}
